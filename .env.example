# Copy Neon values into .env.local with `neon env pull`; never commit credentials.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Comma-separated exact browser origins. Leave empty when serving the frontend
# and API from the same origin.
FRONTEND_ORIGINS=
PORT=3000
NODE_ENV=production

# Only for the one-time initial administrator command; remove after use.
BOOTSTRAP_ADMIN_DOCUMENT=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
